{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Earlybolt",
  "mainBinaryName": "earlybolt",
  "version": "1.0.0",
  "identifier": "com.earlybolt.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "title": "Earlybolt",
        "width": 400,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Utility",
    "shortDescription": "Start your AI 5-hour usage windows on schedule",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Korean"],
        "displayLanguageSelector": true
      }
    }
  }
}
